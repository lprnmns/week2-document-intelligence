DIS_ENVIRONMENT=development
DIS_SERVICE_NAME=document-intelligence-service
# Container images do not include .git. Set this to the checked-out revision
# for reproducible API evaluation manifests; the Compose smoke sets it for you.
DIS_SOURCE_REVISION=unknown
DIS_QDRANT_URL=http://127.0.0.1:6333
DIS_QDRANT_COLLECTION=document_chunks_week2_final_v1
DIS_OLLAMA_URL=http://127.0.0.1:11434
DIS_DEPENDENCY_TIMEOUT_SECONDS=1.0
DIS_MAX_UPLOAD_BYTES=10485760
DIS_MAX_PDF_PAGES=200
DIS_INGESTION_REGISTRY_BACKEND=memory
DIS_INGESTION_DATABASE_PATH=data/ingestions.sqlite3
DIS_EMBEDDED_WORKER=true
DIS_PRELOAD_MODELS=true
DIS_WORKER_POLL_INTERVAL_SECONDS=1.0
DIS_WORKER_STALE_AFTER_SECONDS=300.0
DIS_WORKER_HEALTH_ENABLED=false
DIS_WORKER_HEARTBEAT_PATH=data/worker_heartbeat.json
DIS_WORKER_HEARTBEAT_INTERVAL_SECONDS=2.0
# Generic PDFs: auto (detect known structure, otherwise generic_v1).
# Existing Week 1 mentor family: mentor_program_v1.
# The 28-page Week 2 program PDF: mentor_program_week2_v1.
DIS_SECTION_MARKER_PROFILE=auto
# Evaluation remains explicit so the frozen mentor benchmark fingerprint is stable.
DIS_EVALUATION_SECTION_MARKER_PROFILE=mentor_program_v1
DIS_DENSE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DIS_SPARSE_MODEL=bm25_qdrant_idf_v2
DIS_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
DIS_CHUNK_SIZE_SENTENCES=3
DIS_CHUNK_OVERLAP_SENTENCES=1
DIS_GENERIC_PARENT_MAX_CHARS=4000
DIS_RETRIEVAL_CANDIDATE_K=30
DIS_RETRIEVAL_FUSION_K=20
DIS_RETRIEVAL_RERANK_K=5
DIS_RRF_K=60
DIS_LOG_LEVEL=INFO
DIS_LOG_QUERY_TEXT=false
DIS_RERANKER_ENABLED=false
DIS_LLM_MODEL=gemma3:4b
DIS_LLM_TIMEOUT_SECONDS=120
DIS_LLM_MAX_EVIDENCE_CHARS=2400
DIS_LLM_MAX_OUTPUT_TOKENS=64
DIS_ANSWERABILITY_MIN_DENSE_SCORE=0.338
DIS_ANSWERABILITY_GENERIC_MIN_DENSE_SCORE=0.247
DIS_ANSWERABILITY_MIN_SPARSE_SCORE=0.1
DIS_ANSWERABILITY_MIN_RERANK_SCORE=-5.0
DIS_ANSWERABILITY_MIN_MARGIN=0.0
DIS_ANSWERABILITY_MIN_COVERAGE=0.0
DIS_ANSWERABILITY_GENERIC_MIN_COVERAGE=0.367
DIS_ANSWERABILITY_GENERIC_CALIBRATION_ID=generic_document_answerability_v1
DIS_DEMO_TRACE_ENABLED=true
DIS_DEMO_TRACE_TTL_SECONDS=900
DIS_DEMO_TRACE_MAX_RUNS=32
DIS_SYSTEM_PROFILE_ENABLED=true
# Keep false unless this is an explicitly local development environment.
DIS_LOCAL_MODEL_MANAGEMENT_ENABLED=false
DIS_OLLAMA_MODEL_CATALOG=gemma3:4b,qwen3:4b
DIS_MODEL_CONTEXT_LENGTH=4096
# Compose demo seed: uploads the fictional NOVA PDFs through POST /v1/documents.
DEMO_SEED_ENABLED=true
DEMO_SEED_TENANT_ID=final-demo-v1
DEMO_SEED_ACL_TAGS=public
